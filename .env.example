# Local offline usage requires none of these. Set actual values only in ignored env files
# or protected deployment environments. Never commit a filled copy.
WARMSTART_LOCAL_DB=artifacts/warmstart.sqlite3
CF_ACCOUNT_ID=replace-with-account-id
D1_DATABASE_ID=replace-with-provisioned-database-id
ACCESS_ISSUER=https://your-team.cloudflareaccess.com
ACCESS_AUDIENCE=replace-with-application-audience
# Non-secret provisioned gateway slug in the same account. Empty fails paid-call preflight.
AI_GATEWAY_ID=
# metadata retains metrics, requesting no prompt/response bodies; off skips the entire log.
# Hosted payload-suppression verification is a pre-pilot gate; no proof is implied here.
AI_GATEWAY_LOG_MODE=metadata
